# ==============================================================================
# STOPSHOP ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your secure credentials.
# NEVER commit your actual .env file or real secrets to version control!

# ------------------------------------------------------------------------------
# 1. Application & Frontend URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Authentication & Security (CRITICAL)
# ------------------------------------------------------------------------------
# Must be a cryptographically strong random string (minimum 32 characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-32-char-random-jwt-secret-placeholder"

# Secret token required to trigger background cron jobs (e.g., payouts, SLAs)
CRON_SECRET="your-cron-secret-placeholder"

# ------------------------------------------------------------------------------
# 3. Admin & Vendor Setup Credentials
# ------------------------------------------------------------------------------
# Required by scripts/upsert-admin.js and prisma/seed.js
ADMIN_EMAIL="admin@stopshop.com"
ADMIN_PASSWORD="your-strong-admin-password-here"
VENDOR_PASSWORD="your-strong-vendor-password-here"

# ------------------------------------------------------------------------------
# 4. Database Connection
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@localhost:3306/stopshop"

# ------------------------------------------------------------------------------
# 5. Payment Gateways (Razorpay & PayU)
# ------------------------------------------------------------------------------
# Razorpay (NEXT_PUBLIC_RAZORPAY_KEY_ID is safe for browser checkout widget)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# PayU India
PAYU_MERCHANT_KEY="your-payu-key"
PAYU_MERCHANT_SALT="your-payu-salt"
PAYU_BASE_URL="https://test.payu.in"

# ------------------------------------------------------------------------------
# 6. Logistics & Shipping (Shiprocket)
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL="your-shiprocket-email@example.com"
SHIPROCKET_PASSWORD="your-shiprocket-password"
SHIPROCKET_WEBHOOK_SECRET="your-shiprocket-webhook-secret"

# ------------------------------------------------------------------------------
# 7. Cloud Storage & Media (Cloudinary)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# 8. AI & Notifications (Google Gemini, OpenAI, Resend)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
RESEND_API_KEY="your-resend-api-key"
